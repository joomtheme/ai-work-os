{
  "name": "ai-work-os",
  "version": "0.1.0",
  "description": "Mission-based AI workforce platform — deterministic development kernel",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "worker": "node --env-file=.env --import tsx scripts/worker.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src scripts tests *.json *.md next.config.ts .github/workflows/*.yml compose.yaml",
    "format:check": "prettier --check src scripts tests *.json *.md next.config.ts .github/workflows/*.yml compose.yaml",
    "test:http": "node tests/http.cjs",
    "worker:coding": "node --env-file=.env --import tsx scripts/coding-worker.ts"
  },
  "type": "module",
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "private": true
}
